---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Experience">
  <h1 class="text-3xl font-bold mb-8">Professional Experience</h1>
  <div class="my-8 flex justify-center">
    <object
      data="/ejhumphrey_20251114.pdf"
      type="application/pdf"
      class="block w-[100%] h-[650px] border border-gray-300 rounded-lg overflow-hidden"
    >
      <p>
        Your browser does not support PDF previews.
        <a 
          href="/ejhumphrey_20251114.pdf" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="text-accent hover:underline"
        >
          Click here to view the PDF instead.
        </a>
      </p>
    </object>
  </div>
</MainLayout>
